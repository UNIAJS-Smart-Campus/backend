# ============================================================
# PRODUCCION - copiar a .env.prod y completar
# ============================================================

# Dominio del API. El DNS A/AAAA debe apuntar a la IP del VPS.
API_DOMAIN=api.tudominio.com

# ------------------------------------------------------------
# MYSQL
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=cambia-por-una-clave-larga-y-aleatoria
MYSQL_DATABASE=uajs_smart_campus
MYSQL_USER=uajs
MYSQL_PASSWORD=cambia-por-otra-clave-larga-y-aleatoria

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=genera-un-secreto-de-48-bytes
JWT_EXPIRES=24h

# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------
# Dominio exacto de Vercel. Si usas previews, agrega cada dominio separado por coma.
CORS_ORIGINS=https://tu-app.vercel.app
FRONT_URL=https://tu-app.vercel.app

# ------------------------------------------------------------
# WEBHOOK INTERNO (notificaciones entre servicios)
# ------------------------------------------------------------
# Generar otro secreto distinto al JWT.
NOTIFICATIONS_WEBHOOK_SECRET=genera-otro-secreto

# ------------------------------------------------------------
# CORREO (opcional, para recuperar contraseña)
# ------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@tudominio.com
# SMTP_PASS=clave-de-aplicacion
# SMTP_FROM=Smart Campus <no-responder@tudominio.com>

# ------------------------------------------------------------
# BUSQUEDA / ELASTICSEARCH (opcional)
# ------------------------------------------------------------
# SEARCH_REINDEX_INTERVAL_MS=0
# ES_JAVA_OPTS=-Xms512m -Xmx512m

# ------------------------------------------------------------
# REIMPORTAR LA BASE (destructivo)
# ------------------------------------------------------------
# DB_RESET=1
