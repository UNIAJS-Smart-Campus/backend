# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=uajs_smart_campus

# ============================================
# AUTENTICACION
# ============================================
# Obligatorio: el gateway y el auth-service se niegan a arrancar sin él.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Todos los servicios deben usar el mismo valor.
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES=24h

# ============================================
# PUERTOS DE LOS SERVICIOS
# ============================================
GATEWAY_PORT=3000                 # API Gateway
AUTH_SERVICE_PORT=3001            # Autenticación
USERS_SERVICE_PORT=3002           # Usuarios
EVENTS_SERVICE_PORT=3003          # Eventos
RESERVATIONS_SERVICE_PORT=3004    # Reservas
NOTIFICATIONS_SERVICE_PORT=3005   # Notificaciones
REQUESTS_SERVICE_PORT=3006        # Solicitudes
RESOURCES_SERVICE_PORT=3007       # Recursos
PQRS_SERVICE_PORT=3008            # PQRS
INFO_ACADEMICA_SERVICE_PORT=3009  # Información Académica
CONFIGURACION_SERVICE_PORT=3010   # Configuración
SEARCH_SERVICE_PORT=3011          # Búsqueda (Elasticsearch)

# ============================================
# BÚSQUEDA
# ============================================
# Reindexado automático de Elasticsearch. 0 o vacío = desactivado.
# P. ej. 300000 reindexa cada 5 minutos (evita reindexar a mano).
SEARCH_REINDEX_INTERVAL_MS=0

# Reindexado por cambio (lo dispara el gateway tras una escritura en una
# tabla indexada). No hace falta configurarlo; se ajusta solo si molesta.
# SEARCH_REINDEX_DEBOUNCE_MS=3000   # espera antes de reindexar (agrupa ráfagas)
# SEARCH_REINDEX_TIMEOUT_MS=15000   # máximo que espera al search-service
# SEARCH_SERVICE_URL=http://search-service:3011  # destino del aviso (Docker)

# ============================================
# TIEMPO REAL / NOTIFICACIONES
# ============================================
# Secreto compartido entre los servicios que emiten eventos y el
# notifications-service. Cada entorno debe usar su propio valor.
NOTIFICATIONS_WEBHOOK_SECRET=cambiar-por-un-secreto-compartido

# ============================================
# CORREO (recuperación de contraseña)
# ============================================
# Opcional. Si no se configura, /auth/recuperar responde 503 con un mensaje
# honesto ("servicio de correo no configurado") en vez de fingir el envío.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una
# "contraseña de aplicación" (no la del correo) en SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@uajs.edu.co
# SMTP_PASS=contraseña_de_aplicacion
# SMTP_FROM=Smart Campus UNIAJS <no-responder@uajs.edu.co>

# URL del front, para armar el enlace del correo.
FRONT_URL=http://localhost:5173
